DATABASE_URL="postgresql://user:password@localhost:5432/multiatendimento"
JWT_SECRET="troque-por-uma-chave-segura"
PORT=3002
FRONTEND_URL="http://localhost:5174"
GEMINI_CHAT_MODELS="gemini-3.7-flash,gemini-3.6-flash,gemini-2.5-flash"
GEMINI_LIGHT_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite"
GEMINI_MULTIMODAL_MODELS="gemini-3.7-flash,gemini-3.6-flash,gemini-2.5-flash"
# Contingência opcional. Normalmente as chaves e o modelo são configurados
# por empresa no painel e ficam protegidos no banco.
# OPENAI_API_KEY=""
# OPENAI_CHAT_MODEL=""
# ANTHROPIC_API_KEY=""
# ANTHROPIC_CHAT_MODEL=""
# ANTHROPIC_API_VERSION="2023-06-01"
KNOWLEDGE_SEMANTIC_MIN_SCORE=0.64
KNOWLEDGE_LEXICAL_MIN_SCORE=0.34
# Corte semantico reduzido aplicado apenas a itens cujo idioma do documento
# difere do idioma da pergunta (pergunta pt-BR x manual em ingles). A
# similaridade cross-lingual real costuma cair para 0,55-0,63; nunca fica acima
# de KNOWLEDGE_SEMANTIC_MIN_SCORE.
KNOWLEDGE_SEMANTIC_MIN_SCORE_CROSSLANG=0.55
# Manual de fabricante/modelo diferente do citado na pergunta (ou sem
# equipamento no contexto) nao e mais barrado: apenas multiplica o score por
# este fator. Assim um manual que documenta o erro perguntado ainda aparece.
KNOWLEDGE_MODEL_MISMATCH_PENALTY=0.8
# Paginas por lote na extracao de PDFs. Lotes menores protegem PDFs cheios de
# imagem (poucas paginas, XObjects grandes); lotes maiores sao bem mais rapidos
# em manuais longos de texto. Um manual de 54 MB / 1487 paginas leva ~34s em 12
# e ~20s em 200, com pico ~400 MB nos dois casos.
KNOWLEDGE_PDF_PAGE_BATCH_SIZE=12
# KNOWLEDGE_WORKER_HEAP_MB=512
# KNOWLEDGE_WORKER_RSS_MB=768
# KNOWLEDGE_CHUNK_BATCH_SIZE=100
# Dimensoes do embedding (gemini-embedding-001). Padrao do Google e 3072, que
# estourava a memoria ao gravar manuais grandes. 768 e o recomendado e ocupa 4x
# menos. Trocar exige reindexar bases ja gravadas em 3072.
GEMINI_EMBED_DIMENSIONS=768
OS_CONFIRMATION_TIMEOUT_MS=30000
# Horas sem mensagens que encerram uma sessao de atendimento (KPIs do dashboard).
# TICKET_SESSION_INACTIVITY_HOURS=24
# Minutos ocioso que encerram a sessao de um numero autorizado como tecnico:
# passou disso, o bot volta a perguntar Assistente Tecnico (1) ou Atendimento (2).
TECHNICIAN_SESSION_INACTIVITY_MINUTES=10

# Defaults opcionais usados somente pelo reparo de configuracoes invalidas.
# Nunca coloque chaves reais no repositorio.
DEFAULT_EVOLUTION_URL=""
DEFAULT_EVOLUTION_KEY=""
# Obrigatorio para receber webhooks. Gere um valor aleatorio forte e configure
# o mesmo segredo no provedor; sem ele a rota falha fechado (503).
WEBHOOK_SECRET="gere-um-segredo-aleatorio-com-32-ou-mais-caracteres"
# Intervalo da verificação automática das conexões Evolution (milissegundos).
INSTANCE_HEALTH_INTERVAL_MS=30000
# Somente para desenvolvimento local, nunca em producao.
ALLOW_UNSIGNED_WEBHOOKS="false"

# URL publica do backend usada ao registrar webhooks (sem barra no final).
PUBLIC_URL=""
# Opcional: se definida, os webhooks da Evolution sao registrados com ESTA URL
# em vez da PUBLIC_URL. Use um endereco INTERNO (ex.: http://multiatendimento_backend:3002)
# para tirar DNS/proxy/TLS/internet publica do caminho -- e ali que entregas
# transitorias falham. So use se a rota interna estiver verificada.
EVOLUTION_WEBHOOK_URL=""
# Alarme de "instancia muda": instancia conectada mas sem NENHUM evento da
# Evolution ha mais que isto (ms) vira degradada/silent na tela de Conexoes.
WEBHOOK_SILENCE_ALERT_MS=1500000
# A cada este intervalo (ms) o CRM puxa as mensagens recentes de cada instancia
# conectada e preenche o que faltou (rede de seguranca contra webhook perdido).
WEBHOOK_RECONCILE_INTERVAL_MS=600000

# Opcionais: token global de contingencia do agente e volume persistente de midia.
FIREBIRD_SYNC_TOKEN=""
UPLOADS_PATH=""
APP_TIMEZONE="America/Sao_Paulo"

# Pacote do agente local (monte um volume persistente do EasyPanel neste diretório)
FIREBIRD_AGENT_RELEASE_DIR="/data/agent-releases"
FIREBIRD_AGENT_FILE_NAME="FirebirdCRMClient.exe"
FIREBIRD_AGENT_VERSION="1.0.9"
# Opcional: URL externa de contingência quando o volume ainda não tiver o executável
FIREBIRD_AGENT_DOWNLOAD_URL="https://github.com/connectbrazilads/multiatendimento/raw/main/firebird-client/FirebirdCRMClient.exe"
# Opcional: hash SHA-256 exibido para conferência do arquivo
FIREBIRD_AGENT_SHA256=""
FIREBIRD_AGENT_RELEASED_AT=""

# Integração PrintGuard (obrigatório para armazenar tokens com AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRINTGUARD_ENCRYPTION_KEY=""
# URL da API PrintGuard e callback público (opcionais; URL pode ser informada no pareamento)
PRINTGUARD_URL=""
PRINTGUARD_CALLBACK_URL=""
# A busca periódica é um fallback para eventos cujo webhook não seja entregue.
PRINTGUARD_AUTO_SYNC_ENABLED="true"
PRINTGUARD_AUTO_SYNC_INTERVAL_MS="120000"
