generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  ticketPresences TicketPresence[]
  attendancePolicy AttendancePolicy?
  attendanceTasks AttendanceTask[]
  maxConcurrentSessions      Int?
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  plan                       String                      @default("trial") // trial, starter, pro, enterprise
  active                     Boolean                     @default(true)
  maxConnections             Int                         @default(1)
  maxUsers                   Int                         @default(5)
  primaryColor               String?                     @default("#D4AF37")
  logoUrl                    String?
  lifecycleStatus            String                      @default("active") // implementation, trial, active, suspended, cancelled
  financialStatus            String                      @default("current") // current, overdue, blocked, cancelled
  contractNumber             String?
  contractStartedAt          DateTime?
  contractEndsAt             DateTime?
  trialEndsAt                DateTime?
  nextBillingAt              DateTime?
  customMonthlyPriceCents    Int?
  discountPercent            Float?
  commercialNotes            String?                     @db.Text
  createdAt                  DateTime                    @default(now())
  contacts                   Contact[]
  quickResponses             QuickResponse[]
  quickResponseAudits        QuickResponseAudit[]
  scheduledMessages          ScheduledMessage[]
  internalMessages           InternalMessage[]
  teams                      Team[]
  settings                   TenantSettings?
  tickets                    Ticket[]
  users                      User[]
  technicalContacts          TechnicalContact[]
  instances                  WaInstance[]
  metaInstances              MetaInstance[]
  knowledges                 Knowledge[]
  knowledgeDocuments         KnowledgeDocument[]
  knowledgeChunks            KnowledgeChunk[]
  ticketSessions             TicketSession[]
  businessHours              BusinessHour[]
  knowledgeLogs              KnowledgeLog[]
  tags                       Tag[]
  equipments                 Equipment[]
  serviceOrders              ServiceOrder[]
  leads                      Lead[]
  syncRecords                ExternalSyncRecord[]
  crmCustomers               CrmCustomer[]
  crmEquipments              CrmEquipment[]
  crmOsTypes                 CrmOsType[]
  crmTechnicians             CrmTechnician[]
  crmDefectTypes             CrmDefectType[]
  supportAccessSessions      SupportAccessSession[]
  billingLogs                BillingLog[]
  revenueSnapshots           RevenueSnapshot[]
  userTicketStates           UserTicketState[]
  privacyAuditLogs           PrivacyAuditLog[]
  auditEvents                AuditEvent[]
  privacyRetentionPolicy     PrivacyRetentionPolicy?
  privacyPolicies            PrivacyPolicy[]
  privacyAcceptances         PrivacyAcceptance[]
  internalMessageReads       InternalMessageRead[]
  internalMessageReactions   InternalMessageReaction[]
  internalConversationStates InternalConversationState[]
  campaigns                  Campaign[]
  campaignRecipients         CampaignRecipient[]
  campaignTemplates          CampaignTemplate[]
  printGuardConnections      PrintGuardConnection[]
  printGuardBindings         PrintGuardBinding[]
  printGuardTelemetryEvents  PrintGuardTelemetryEvent[]
  crmContracts               CrmContract[]
  crmMeterReadings           CrmMeterReading[]
  crmBillingStatements       CrmBillingStatement[]
  crmBillingStatementLines   CrmBillingStatementLine[]
  waInstanceHealthEvents     WaInstanceHealthEvent[]
  firebirdAgents             FirebirdAgent[]
  featureOverrides           TenantFeatureOverride[]
  deploymentChecklistItems   DeploymentChecklistItem[]
  agentVersionActions        AgentVersionAction[]

  @@index([lifecycleStatus])
  @@index([financialStatus])
}

model Feature {
  id          String                  @id @default(cuid())
  key         String                  @unique
  name        String
  description String?
  category    String?
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  plans       PlanFeature[]
  overrides   TenantFeatureOverride[]
}

model ProductPlan {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  description  String?
  active       Boolean       @default(true)
  position     Int           @default(0)
  monthlyPrice Decimal       @default(0) @db.Decimal(12, 2)
  limits       Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  features     PlanFeature[]
}

model PlanFeature {
  id        String      @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean     @default(true)
  limits    Json?
  plan      ProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
}

model TenantFeatureOverride {
  id        String   @id @default(cuid())
  tenantId  String
  featureId String
  enabled   Boolean?
  limits    Json?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@index([featureId])
}

model TenantSettings {
  id                             String  @id @default(cuid())
  tenantId                       String  @unique
  tenant                         Tenant  @relation(fields: [tenantId], references: [id])
  evolutionUrl                   String?
  evolutionKey                   String?
  geminiKey                      String?
  aiProvider                     String  @default("gemini")
  aiModel                        String?
  openaiKey                      String?
  anthropicKey                   String?
  // Motor auxiliar só para embeddings/áudio quando o provedor principal é
  // Anthropic (Claude não tem essas APIs). "openai" | "gemini" | null (= sem
  // auxiliar: base de conhecimento cai para busca por palavra-chave e áudio
  // fica sem transcrição).
  aiAuxProvider                  String?
  // Catálogo de modelos descoberto por provedor na tela de configurações:
  // { openai: { models: [{id,label}], at: ISO }, anthropic: {...}, gemini: {...} }
  aiModelCatalog                 Json?
  botEnabled                     Boolean @default(false)
  botName                        String? @default("LCD Bot")
  botSystemPrompt                String? @db.Text
  botTransferWord                String? @default("atendente")
  webhookUrl                     String?
  outOfOfficeMessage             String? @db.Text
  notificationPhone              String?
  serviceOrderManagerCopyEnabled Boolean @default(false)
  serviceOrderManagerPhone       String?
  serviceOrderManagerInstanceId  String?
  billingInstanceId              String?
  ratingEnabled                  Boolean @default(false)
  ratingMessage                  String? @default("Como você avalia nosso atendimento de 1 a 5?") @db.Text

  // Dados da Empresa para PDF/OS
  companyName      String?
  companyCnpj      String?
  companyIE        String?
  companyAddress   String?
  companyBairro    String?
  companyCep       String?
  companyPhone     String?
  companyCity      String?
  companyState     String?
  // Cor de destaque do cabecalho/bandas da O.S. (o texto continua preto).
  // Hex #RRGGBB; null = vermelho padrao.
  osAccentColor    String? @default("#D62828")
  // Exibe o numero da O.S. em Code 128 no cabecalho do documento oficial.
  osBarcodeEnabled Boolean @default(true)

  // SerpAPI para Prospecção de Leads
  serpApiKey String?

  // IntegraÃ§Ã£o com API client da empresa / Firebird
  firebirdApiUrl              String?
  firebirdApiKey              String?
  firebirdClientToken         String?
  firebirdAuthMode            String?   @default("bearer")
  firebirdHealthPath          String?   @default("/health")
  firebirdContactsPath        String?   @default("/contacts")
  firebirdSyncEnabled         Boolean   @default(false)
  firebirdLastSyncAt          DateTime?
  firebirdLastSyncStatus      String?   @default("idle")
  firebirdLastSyncError       String?   @db.Text
  billingMessageTemplate      String?   @db.Text
  firebirdQueueBillingProcess Boolean   @default(false)

  // PlugBoleto (TecnoSpeed) - o CRM busca o PDF do boleto direto na API do
  // banco, sem depender da pasta monitorada. Credenciais por cedente vindas
  // do iLux (CE_CEDENTE / CE_PARAM_CONFIG). O token fica cifrado.
  plugBoletoEnabled        Boolean   @default(false)
  plugBoletoBaseUrl        String?   @default("https://plugboleto.com.br/api/v1")
  plugBoletoPrintPath      String?   @default("/boletos/impressao/lote")
  plugBoletoCedenteCnpj    String?
  plugBoletoTokenCipher    String?   @db.Text
  plugBoletoConfigSyncedAt DateTime? // último push da credencial pelo agente

  // Fase 2 "faturamento sem a pasta": quando ligado, o CRM re-renderiza o
  // demonstrativo a partir de CrmBillingStatement (dados do iLux, sem recalcular)
  // em vez de exigir o PDF oficial na pasta monitorada. Rollout por tenant.
  statementRerenderEnabled Boolean @default(false)

  // Resumo da ultima varredura do envio automatico (empurrado pelo agente a cada
  // ciclo): { checkedAt, checked, ready, alreadySent, skippedPeriod, ambiguous,
  // missingByType:{invoice,statement,boleto} }. Alimenta a visao operacional de
  // "titulos aguardando documento na pasta".
  billingScanStatus Json?

  // Configurações de KPI do RevGuard AI
  kpiContractValue       Float? @default(1200.0)
  kpiServiceValue        Float? @default(350.0)
  kpiSlaLimitHours       Int?   @default(24)
  kpiReincidentThreshold Int?   @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Inventário de instalações do agente Firebird (FirebirdCRMClient.exe). Uma
// linha por (tenant, installId), atualizada a cada ping. O agente já envia
// installId, version, protocolVersion, capabilities e health em POST /ping;
// aqui isso deixa de ser descartado. Alimenta a visão de frota e o alerta de
// "agente desatualizado" comparando `version` com o release.json publicado.
model FirebirdAgent {
  id              String               @id @default(cuid())
  tenantId        String
  installId       String
  hostname        String?
  version         String?
  protocolVersion String?
  capabilities    Json?
  runtime         String? // "executable" | "python"
  processId       Int?
  healthStatus    String? // health.status reportado pelo agente (ex.: "online")
  lastPingIp      String?
  firstSeenAt     DateTime             @default(now())
  lastSeenAt      DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  releaseChannel  String               @default("stable")
  compatibility   Json?
  desiredVersion  String?
  versionActions  AgentVersionAction[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, installId])
  @@index([tenantId, lastSeenAt])
}

model AgentVersionAction {
  id              String        @id @default(cuid())
  tenantId        String
  firebirdAgentId String
  action          String
  channel         String        @default("stable")
  fromVersion     String?
  targetVersion   String
  status          String        @default("pending")
  requestedById   String
  reason          String?
  error           String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent           FirebirdAgent @relation(fields: [firebirdAgentId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([firebirdAgentId, createdAt])
}

model DeploymentChecklistItem {
  id          String    @id @default(cuid())
  tenantId    String
  itemKey     String
  label       String
  category    String
  status      String    @default("pending")
  notes       String?
  updatedById String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemKey])
  @@index([tenantId, category, status])
}

model User {
  ticketPresences TicketPresence[]
  attendanceAvailable Boolean @default(true)
  attendanceHeartbeatAt DateTime?
  assignedAttendanceTasks AttendanceTask[] @relation("TaskAssignee")
  createdAttendanceTasks AttendanceTask[] @relation("TaskCreator")
  id                         String                      @id @default(cuid())
  tenantId                   String
  name                       String
  email                      String
  password                   String
  role                       String                      @default("agent")
  supportLevel               String?
  lastLoginAt                DateTime?
  accessProfile              String                      @default("agent")
  permissions                Json?
  homePage                   String?
  phone                      String?
  firebirdSupportName        String?
  avatarUrl                  String?
  active                     Boolean                     @default(true)
  maxConcurrentSessions      Int?
  totpSecretCipher           String?
  totpPendingSecretCipher    String?
  totpEnabledAt              DateTime?
  totpRecoveryCodes          Json?
  createdAt                  DateTime                    @default(now())
  messages                   Message[]
  sentInternalMessages       InternalMessage[]           @relation("InternalSender")
  receivedInternalMessages   InternalMessage[]           @relation("InternalReceiver")
  teamMembers                TeamMember[]
  tickets                    Ticket[]
  ticketEvents               TicketEvent[]
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id])
  serviceOrders              ServiceOrder[]
  closedOrders               ServiceOrder[]              @relation("ClosedBy")
  ticketStates               UserTicketState[]
  internalMessageReads       InternalMessageRead[]
  internalMessageReactions   InternalMessageReaction[]
  internalConversationStates InternalConversationState[]
  campaigns                  Campaign[]
  quickResponses             QuickResponse[]             @relation("QuickResponseOwner")
  quickResponseAudits        QuickResponseAudit[]
  auditEvents                AuditEvent[]                @relation("AuditEventActor")
  supportAccessSessions      SupportAccessSession[]      @relation("SupportAccessActor")
  authSessions               AuthSession[]

  @@unique([tenantId, email])
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  tenantId     String
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([tenantId, createdAt])
}

// Técnicos de campo podem usar o assistente técnico pelo WhatsApp sem possuir
// conta, senha ou acesso ao painel web. O telefone ativo é a autorização
// explícita para o modo técnico.
model TechnicalContact {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String
  phone               String
  firebirdSupportName String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId, active])
}

model Team {
  attendanceTasks AttendanceTask[]
  id               String            @id @default(cuid())
  tenantId         String
  name             String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  members          TeamMember[]
  tickets          Ticket[]
  internalMessages InternalMessage[]
  quickResponses   QuickResponse[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model WaInstance {
  id                  String              @id @default(cuid())
  tenantId            String
  instanceName        String
  phone               String?
  status              String              @default("disconnected")
  healthStatus        String              @default("unknown")
  lastConnectionState String?
  lastConnectionAt    DateTime?
  lastWebhookAt       DateTime?
  lastHealthCheckAt   DateTime?
  lastHealthError     String?
  qrCode              String?
  provider            String              @default("evolution_qr")
  officialPhoneId     String?
  officialBusinessId  String?
  contacts            Contact[]
  tickets             Ticket[]
  campaigns           Campaign[]
  campaignRecipients  CampaignRecipient[]
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
}

// Historico append-only de saude das instancias WhatsApp. Uma linha por
// TRANSICAO de estado/health (nao a cada checagem) + eventos de "instancia
// muda" (conectada mas sem receber webhook). Sem isso, um incidente
// transitorio nao deixa rastro -- o WaInstance so guarda o estado atual.
model WaInstanceHealthEvent {
  id              String    @id @default(cuid())
  tenantId        String
  instanceId      String
  instanceName    String
  status          String // connected | connecting | disconnected | degraded
  healthStatus    String // healthy | unstable | offline | degraded | silent | misconfigured
  connectionState String? // open | connecting | close | unknown
  lastWebhookAt   DateTime?
  webhookAgeSec   Int?
  error           String?   @db.Text
  source          String // health-monitor | webhook
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, instanceName, createdAt])
  @@index([createdAt])
}

model MetaInstance {
  id          String  @id @default(cuid())
  tenantId    String
  name        String // Nome amigável (ex: "Facebook Loja X")
  type        String // "facebook" ou "instagram"
  externalId  String? // ID da Página ou do Instagram Account
  accessToken String? // Token da Página (se disponível)

  metaBrowserSession Json? // Cookies/LocalStorage para automação fallback

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  tickets Ticket[]
}

model Contact {
  attendanceTasks AttendanceTask[]
  id                String    @id @default(cuid())
  tenantId          String
  instanceId        String
  crmCustomerId     String?
  externalSource    String?   @default("manual")
  externalId        String?
  externalUpdatedAt DateTime?
  phone             String
  name              String?
  fantasyName       String?
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  notes             String?
  tags              String    @default("[]")
  whatsapp          String?
  whatsappJid       String?

  // Dados extras para CRM
  cpfCnpj                 String?
  email                   String?
  address                 String?
  city                    String?
  state                   String?
  zipCode                 String?
  enableWhatsAppBilling   Boolean   @default(false)
  enableWhatsAppMarketing Boolean   @default(false)
  enableWhatsAppAlerts    Boolean   @default(false)
  enableWhatsAppCounters  Boolean   @default(false)
  whatsappOptOutAt        DateTime?

  instance           WaInstance          @relation(fields: [instanceId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  crmCustomer        CrmCustomer?        @relation(fields: [crmCustomerId], references: [id], onDelete: SetNull)
  tickets            Ticket[]
  scheduledMessages  ScheduledMessage[]
  equipments         Equipment[]
  serviceOrders      ServiceOrder[]
  campaignRecipients CampaignRecipient[]

  @@unique([tenantId, instanceId, phone])
  @@unique([tenantId, externalSource, externalId])
  @@index([tenantId, phone])
  @@index([tenantId, crmCustomerId])
}

model Ticket {
  presences TicketPresence[]
  attendanceTasks AttendanceTask[]
  slaPolicyKey String?
  slaWarnedAt DateTime?
  slaBreachedAt DateTime?
  id             String    @id @default(cuid())
  tenantId       String
  instanceId     String?
  metaInstanceId String?
  contactId      String
  teamId         String?
  agentId        String?
  status         String    @default("pending")
  priority       String    @default("medium") // low, medium, high, urgent
  subject        String?
  unreadCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?

  // Início da conversa/sessão atual. Reiniciado a cada reabertura (o mesmo Ticket
  // é reaproveitado por contato), para que métricas sejam por conversa e não pela
  // data do primeiro contato histórico.
  sessionStartedAt DateTime?

  // SLA Fields
  slaDueAt              DateTime?
  firstResponseAt       DateTime?
  lastCustomerMessageAt DateTime?
  lastMessageAt         DateTime? @default(now()) // Para ordenação estável da lista

  // Avaliação do Atendimento (CSAT)
  rating         Int?
  ratingAt       DateTime?
  ratingFeedback String?

  // Auditoria por IA
  auditScore  Int?
  auditResult String?   @db.Text
  auditedAt   DateTime?

  messages      Message[]
  events        TicketEvent[]
  agent         User?             @relation(fields: [agentId], references: [id])
  contact       Contact           @relation(fields: [contactId], references: [id])
  instance      WaInstance?       @relation(fields: [instanceId], references: [id])
  metaInstance  MetaInstance?     @relation(fields: [metaInstanceId], references: [id])
  team          Team?             @relation(fields: [teamId], references: [id])
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  serviceOrders ServiceOrder[]
  userStates    UserTicketState[]
  knowledgeLogs KnowledgeLog[]
  sessions      TicketSession[]

  @@index([tenantId])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, agentId, status])
  @@index([tenantId, teamId, status])
  @@index([instanceId])
  @@index([contactId])
  @@index([status])
  @@index([createdAt])
  @@index([sessionStartedAt])
}

model TicketSession {
  id            String    @id @default(cuid())
  tenantId      String
  ticketId      String
  agentId       String?
  startedAt     DateTime
  endedAt       DateTime?
  status        String    @default("OPEN") // OPEN, RESOLVED, INACTIVE
  trigger       String    @default("CREATED") // CREATED, REOPENED, INACTIVITY, HISTORICAL
  // Modo escolhido pelo remetente autorizado como técnico nesta sessão:
  // null = ainda não escolheu (bot pergunta), TECHNICIAN, CUSTOMER.
  assistantMode String?
  reconstructed Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, endedAt])
  @@index([tenantId, agentId, endedAt])
  @@index([ticketId, startedAt])
  @@index([tenantId, reconstructed])
}

model UserTicketState {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  ticketId  String
  isPinned  Boolean   @default(false)
  isUnread  Boolean   @default(false)
  pinnedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, ticketId])
  @@index([tenantId, userId, isPinned])
  @@index([ticketId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  tenantId  String
  userId    String?
  type      String // assigned, transferred, resolved, reopened, note, etc.
  payload   String?  @db.Text // JSON string with extra details (ex: "from team X to team Y")
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
}

model Knowledge {
  id        String         @id @default(cuid())
  tenantId  String
  question  String         @db.Text
  answer    String         @db.Text
  tags      String?
  embedding Json? // Array de números para busca semântica
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  logs      KnowledgeLog[]

  @@index([tenantId, active])
}

model KnowledgeDocument {
  id              String              @id @default(cuid())
  tenantId        String
  title           String
  description     String?             @db.Text
  category        String              @default("MANUAL") // PROCEDURE, MANUAL, PORTFOLIO
  audience        String              @default("CUSTOMER") // CUSTOMER, AGENT, TECHNICIAN
  manufacturer    String?
  equipmentModel  String?
  version         String?
  language        String              @default("pt-BR")
  status          String              @default("DRAFT") // DRAFT, PROCESSING, PUBLISHED, FAILED, REPLACED
  originalName    String
  storageKey      String
  mimeType        String
  size            Int
  checksum        String
  pageCount       Int?
  chunkCount      Int                 @default(0)
  processingError String?             @db.Text
  supersedesId    String?
  createdById     String?
  publishedAt     DateTime?
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supersedes      KnowledgeDocument?  @relation("KnowledgeDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  revisions       KnowledgeDocument[] @relation("KnowledgeDocumentVersions")
  chunks          KnowledgeChunk[]
  logs            KnowledgeLog[]

  @@unique([tenantId, checksum])
  @@index([tenantId, status, audience])
  @@index([tenantId, manufacturer, equipmentModel])
  @@index([supersedesId])
}

model KnowledgeChunk {
  id            String            @id @default(cuid())
  tenantId      String
  documentId    String
  content       String            @db.Text
  section       String?
  pageStart     Int?
  pageEnd       Int?
  position      Int
  tokenEstimate Int               @default(0)
  embedding     Json?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  logs          KnowledgeLog[]

  @@unique([documentId, position])
  @@index([tenantId, documentId])
}

model BusinessHour {
  id        String  @id @default(cuid())
  tenantId  String
  dayOfWeek Int
  start     String  @default("08:00")
  end       String  @default("18:00")
  active    Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, dayOfWeek])
}

model Tag {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  color      String    @default("#D4AF37")
  archivedAt DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, archivedAt])
}

model Message {
  id             String         @id @default(cuid())
  ticketId       String
  agentId        String?
  fromBot        Boolean        @default(false)
  automationType String? // AI, TRANSFER_CONFIRMATION, CSAT, SYSTEM
  fromMe         Boolean        @default(false)
  body           String
  transcription  String?
  mediaUrl       String?
  mediaType      String?
  mediaStatus    String?        @default("pending") // pending, ok, failed
  externalId     String?
  quotedMsgId    String?
  quotedMsgBody  String?
  fileName       String?
  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  agent          User?          @relation(fields: [agentId], references: [id])
  ticket         Ticket         @relation(fields: [ticketId], references: [id])
  knowledgeLogs  KnowledgeLog[]

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@index([externalId])
  @@index([createdAt])
}

model QuickResponse {
  id          String               @id @default(cuid())
  tenantId    String
  shortcut    String
  message     String               @db.Text
  category    String               @default("GENERAL")
  scope       String               @default("GLOBAL") // GLOBAL, TEAM, PERSONAL
  ownerUserId String?
  teamId      String?
  usageCount  Int                  @default(0)
  lastUsedAt  DateTime?
  isFavorite  Boolean              @default(false)
  archivedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User?                @relation("QuickResponseOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  team        Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  audits      QuickResponseAudit[]

  @@unique([tenantId, shortcut])
  @@index([tenantId, scope, category])
  @@index([tenantId, archivedAt])
  @@index([ownerUserId])
  @@index([teamId])
}

model QuickResponseAudit {
  id              String   @id @default(cuid())
  tenantId        String
  quickResponseId String?
  actorUserId     String?
  action          String
  metadata        Json?
  createdAt       DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quickResponse QuickResponse? @relation(fields: [quickResponseId], references: [id], onDelete: SetNull)
  actor         User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, quickResponseId, createdAt])
  @@index([actorUserId])
}

model ScheduledMessage {
  instanceId String?
  status String @default("queued")
  attempts Int @default(0)
  nextAttemptAt DateTime?
  claimedAt DateTime?
  claimToken String?
  sentAt DateTime?
  lastError String?
  providerMessageId String?
  deliveryUncertain Boolean @default(false)

  @@index([status, sendAt, nextAttemptAt])
  @@index([tenantId, contactId, sendAt])
  id        String   @id @default(cuid())
  tenantId  String
  contactId String
  body      String
  sendAt    DateTime
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model InternalMessage {
  id                 String                    @id @default(cuid())
  tenantId           String
  senderId           String
  receiverId         String?
  teamId             String?
  type               String                    @default("message")
  body               String
  replyToId          String?
  mentionUserIds     Json?
  mentionTeamIds     Json?
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
  receiver           User?                     @relation("InternalReceiver", fields: [receiverId], references: [id])
  sender             User                      @relation("InternalSender", fields: [senderId], references: [id])
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  team               Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  replyTo            InternalMessage?          @relation("InternalMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            InternalMessage[]         @relation("InternalMessageReplies")
  reactions          InternalMessageReaction[]
  reads              InternalMessageRead[]

  @@index([tenantId, receiverId, createdAt])
  @@index([tenantId, teamId, createdAt])
  @@index([tenantId, attachmentUrl])
  @@index([replyToId, createdAt])
}

model InternalMessageReaction {
  id        String          @id @default(cuid())
  tenantId  String
  messageId String
  userId    String
  emoji     String
  createdAt DateTime        @default(now())
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message   InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([tenantId, messageId])
}

model InternalMessageRead {
  id        String          @id @default(cuid())
  tenantId  String
  messageId String
  userId    String
  readAt    DateTime        @default(now())
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message   InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([tenantId, userId, readAt])
}

model InternalConversationState {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  conversationKey String
  pinned          Boolean   @default(false)
  unreadCount     Int       @default(0)
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, conversationKey])
  @@index([tenantId, userId, pinned, updatedAt])
}

model KnowledgeLog {
  id              String             @id @default(cuid())
  tenantId        String
  ticketId        String?
  messageId       String?
  knowledgeId     String?
  documentId      String?
  chunkId         String?
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  ticket          Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  message         Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  knowledge       Knowledge?         @relation(fields: [knowledgeId], references: [id], onDelete: SetNull)
  document        KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  chunk           KnowledgeChunk?    @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  query           String
  content         String?
  similarity      Float?
  found           Boolean            @default(false)
  searched        Boolean            @default(false)
  method          String?
  error           String?
  responseOrigin  String? // RAG, ILUX_DATA, LLM_GENERAL ou MIXED
  responseSources Json? // Fontes disponibilizadas ao modelo, sem expor ao cliente
  responseModel   String?
  createdAt       DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, responseOrigin, createdAt])
  @@index([ticketId, createdAt])
  @@index([messageId])
  @@index([knowledgeId, createdAt])
  @@index([documentId, createdAt])
  @@index([chunkId, createdAt])
}

model Equipment {
  id                String    @id @default(cuid())
  tenantId          String
  contactId         String
  externalSource    String?   @default("manual")
  externalId        String?
  externalUpdatedAt DateTime?
  model             String
  manufacturer      String?
  type              String?
  serialNumber      String?
  sector            String?
  address           String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]

  @@unique([tenantId, externalSource, externalId])
}

model ServiceOrder {
  attendanceTasks AttendanceTask[]
  id                   String    @id @default(cuid())
  tenantId             String
  contactId            String
  equipmentId          String
  externalSource       String?   @default("manual")
  externalId           String?
  externalUpdatedAt    DateTime?
  requestKey           String?
  ticketId             String?
  cdOstp               String?
  cdDefeito            String?
  nmsuportet           String?
  defect               String? // Descrição do defeito relatado
  status               String    @default("PENDENTE") // PENDENTE, EM_ATENDIMENTO, AGUARDANDO_RETORNO, FINALIZADA
  technicalNotes       String? // Notas do técnico (peças trocadas, pendências)
  meters               String? // Medidores em JSON (ex: {"mono": 1000, "cor": 500})
  userId               String? // Atendente que criou a O.S.
  managerCopySentAt    DateTime?
  managerCopyLastError String?   @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("ClosedBy", fields: [closedById], references: [id])

  user      User?     @relation(fields: [userId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalSource, externalId])
  @@unique([tenantId, requestKey])
}

model ExternalSyncRecord {
  id         String    @id @default(cuid())
  tenantId   String
  source     String
  entity     String
  externalId String?
  payload    Json
  receivedAt DateTime  @default(now())
  syncedAt   DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, entity, externalId])
  @@index([tenantId, source, entity])
}

// Foto diária dos KPIs do iLux Sentinela (Centro de Crise / Benchmark), usada
// para calcular tendência (hoje vs. dia anterior com dado registrado) sem
// precisar de histórico do Firebird, que só reflete o estado atual.
model RevenueSnapshot {
  id             String   @id @default(cuid())
  tenantId       String
  snapshotDate   DateTime @db.Date
  mrrInRisk      Float    @default(0)
  vazamentoValor Float    @default(0)
  stalledCount   Int      @default(0)
  avgOpenHours   Float    @default(0)
  avgSlaHours    Float?
  avgCsat        Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate])
  @@index([tenantId, snapshotDate])
}

model CrmCustomer {
  id                String    @id @default(cuid())
  tenantId          String
  externalSource    String    @default("firebird")
  externalId        String
  externalUpdatedAt DateTime?
  name              String
  fantasyName       String?
  cpfCnpj           String?
  email             String?
  phone             String?
  address           String?
  neighborhood      String?
  city              String?
  state             String?
  zipCode           String?
  contactName       String?
  notes             String?   @db.Text
  raw               Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipments       CrmEquipment[]
  whatsappContacts Contact[]

  @@unique([tenantId, externalSource, externalId])
  @@index([tenantId, name])
  @@index([tenantId, cpfCnpj])
  @@index([tenantId, phone])
}

model CrmEquipment {
  id                 String    @id @default(cuid())
  tenantId           String
  customerId         String?
  externalSource     String    @default("firebird")
  externalId         String
  externalUpdatedAt  DateTime?
  model              String
  manufacturer       String?
  type               String?
  serialNumber       String?
  assetTag           String?
  sector             String?
  installLocation    String?
  address            String?
  city               String?
  state              String?
  phone              String?
  contractExternalId String?
  // Current meter snapshot received from PrintGuard. Historical readings
  // remain available in PrintGuard; these fields make the latest value
  // available to CRM/telemetry without changing the Firebird sync contract.
  pageCounter        Int?
  usageCounters      Json?
  lastMeterReadAt    DateTime?
  meterSource        String?
  isActive           Boolean   @default(true)
  raw                Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer CrmCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalSource, externalId])
  @@index([tenantId, model])
  @@index([tenantId, serialNumber])
  @@index([tenantId, customerId])
}

model Lead {
  id                 String              @id @default(cuid())
  tenantId           String
  placeId            String? // Google Place ID (para evitar duplicatas)
  name               String
  phone              String?
  address            String?
  city               String?
  state              String?
  website            String?
  rating             Float?
  category           String? // Ex: "Escritório de Advocacia"
  query              String? // Busca que originou o lead
  imported           Boolean             @default(false)
  contactId          String? // Se foi importado para Contact
  marketingOptIn     Boolean             @default(false)
  optedOutAt         DateTime?
  sentAt             DateTime? // Data do último envio WhatsApp
  sentCount          Int                 @default(0) // Quantas vezes foi enviado
  createdAt          DateTime            @default(now())
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignRecipients CampaignRecipient[]

  @@unique([tenantId, placeId])
  @@index([tenantId, imported])
  @@index([tenantId, query])
  @@index([tenantId, city, state])
  @@index([tenantId, marketingOptIn, optedOutAt])
  @@index([tenantId, sentAt])
}

model CrmOsType {
  id            String   @id @default(cuid())
  tenantId      String
  code          String // CDOSTP
  name          String // NMOSTP
  formulario    String? // IXLOSTP.FORMULARIO (ex.: MODELO-001)
  formularioObs String?
  tipoOs        String?
  tipoChamado   String?
  logoOs        String?
  inactive      Boolean  @default(false)
  reportBundle  String? // arquivo .rel que contém o modelo no desktop
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

model CrmTechnician {
  id        String   @id @default(cuid())
  tenantId  String
  name      String // NMSUPORTE
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model CrmDefectType {
  id        String   @id @default(cuid())
  tenantId  String
  code      String // IXLOSDEFEITOTP.CDDEFEITO
  name      String // IXLOSDEFEITOTP.NMDEFEITO
  inactive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, inactive])
}

model BillingLog {
  id                String    @id @default(cuid())
  tenantId          String
  cpfCnpj           String?
  clientName        String?
  fileName          String
  status            String // "SUCCESS", "FAILED" ou "TEST" (envio simulado, modo teste)
  errorMessage      String?   @db.Text
  sentAt            DateTime  @default(now())
  // Confirmacao de entrega no WhatsApp (Evolution messages.update / ACK).
  // messageId = id da 1a midia enviada; deliveryStatus: sent|delivered|read|failed.
  messageId         String?
  deliveryStatus    String?   @default("sent")
  deliveryUpdatedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, messageId])
}

model PrivacyAuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  status       String   @default("SUCCESS")
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
}

// Trilha central de auditoria das ações realizadas no painel e pela API.
// Dados de contexto são opcionais para que eventos automáticos também possam
// ser registrados sem inventar um usuário. Metadata deve ser sempre
// sanitizada pelo auditEventService antes de chegar ao banco.
model AuditEvent {
  id           String   @id @default(cuid())
  tenantId     String
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  status       String   @default("SUCCESS")
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, resourceType, resourceId, createdAt])
  @@index([tenantId, requestId])
}

model SupportAccessSession {
  id             String    @id @default(cuid())
  actorUserId    String
  targetTenantId String
  reason         String
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?

  actor        User   @relation("SupportAccessActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetTenant Tenant @relation(fields: [targetTenantId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([targetTenantId, createdAt])
  @@index([expiresAt, endedAt])
}

model PrivacyRetentionPolicy {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  enabled               Boolean   @default(false)
  dryRun                Boolean   @default(true)
  mediaRetentionDays    Int       @default(365)
  auditRetentionDays    Int       @default(730)
  billingRetentionDays  Int       @default(2555)
  agentLogRetentionDays Int       @default(30)
  lastPreviewAt         DateTime?
  lastPreview           Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PrivacyPolicy {
  id          String   @id @default(cuid())
  tenantId    String
  version     String
  title       String
  summary     String?  @db.Text
  purposes    Json
  channel     Json?
  effectiveAt DateTime @default(now())
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, version])
  @@index([tenantId, active, effectiveAt])
}

model PrivacyAcceptance {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  policyVersion String
  scopes        Json
  ipAddress     String?
  userAgent     String?
  acceptedAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, policyVersion])
  @@index([tenantId, userId, acceptedAt])
}

// Campanhas de comunicação em massa. Os registros são persistidos para que
// reinícios do backend não provoquem reenvio nem percam o progresso.
model Campaign {
  id              String              @id @default(cuid())
  tenantId        String
  // Nulo mantém campanhas antigas compatíveis; novos disparos de prospecção
  // sempre informam uma chave explícita antes de criar a campanha.
  idempotencyKey  String?
  createdById     String?
  instanceId      String?
  name            String              @default("Nova campanha")
  category        String              @default("MARKETING") // MARKETING, ALERT, COUNTER, BILLING
  message         String              @db.Text
  mediaUrl        String?
  mediaType       String?
  mediaMimeType   String?
  mediaFilename   String?
  status          String              @default("DRAFT") // DRAFT, QUEUED, RUNNING, PAUSED, COMPLETED, CANCELLED, FAILED
  delaySeconds    Int                 @default(5)
  scheduledAt     DateTime?
  quietHoursStart String?             @default("20:00")
  quietHoursEnd   String?             @default("08:00")
  total           Int                 @default(0)
  sent            Int                 @default(0)
  failed          Int                 @default(0)
  skipped         Int                 @default(0)
  delivered       Int                 @default(0)
  retryCount      Int                 @default(0)
  cancelRequested Boolean             @default(false)
  cancelledAt     DateTime?
  startedAt       DateTime?
  pausedAt        DateTime?
  completedAt     DateTime?
  lastError       String?             @db.Text
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  instance        WaInstance?         @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, createdAt])
}

model CampaignRecipient {
  id              String      @id @default(cuid())
  campaignId      String
  tenantId        String
  leadId          String?
  contactId       String?
  instanceId      String?
  phone           String
  contactName     String?
  renderedMessage String      @db.Text
  status          String      @default("PENDING") // PENDING, SENDING, SENT, DELIVERED, FAILED, SKIPPED, CANCELLED
  reason          String?
  errorMessage    String?     @db.Text
  metadata        Json?
  externalId      String?
  attempts        Int         @default(0)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  skippedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  campaign        Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead            Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  instance        WaInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@index([tenantId, status, updatedAt])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([leadId])
}

model CampaignTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  category    String   @default("MARKETING")
  body        String   @db.Text
  variables   Json?
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active, category])
}

// Integração opcional com o PrintGuard. Segredos são armazenados apenas como
// ciphertext AES-GCM (o valor em claro nunca é devolvido à API/UI).
model PrintGuardConnection {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  baseUrl             String
  externalId          String?   @unique
  organization        Json?
  accessTokenCipher   String?   @db.Text
  webhookSecretCipher String?   @db.Text
  status              String    @default("INACTIVE") // INACTIVE, PENDING, CONNECTED, ERROR
  lastTestAt          DateTime?
  lastConnectedAt     DateTime?
  lastCursor          String?
  lastMeterCursor     String?
  lastError           String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bindings PrintGuardBinding[]
  events   PrintGuardTelemetryEvent[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

// Relações são deliberadamente guardadas pelos IDs externos/locais. O vínculo
// só é considerado válido quando o resolvedor encontra uma correspondência
// inequívoca no CRM; nunca fazemos associação por nome parcial.
model PrintGuardBinding {
  id            String    @id @default(cuid())
  tenantId      String
  connectionId  String
  customerCode  String?
  serialNumber  String?
  customerId    String?
  equipmentId   String?
  state         String    @default("UNMATCHED") // MATCHED, UNMATCHED, AMBIGUOUS
  source        String    @default("AUTO") // AUTO, MANUAL
  confirmedAt   DateTime?
  confirmedById String?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection PrintGuardConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerCode])
  @@index([tenantId, serialNumber])
  @@index([connectionId, state])
}

model PrintGuardTelemetryEvent {
  id                  String    @id @default(cuid())
  tenantId            String
  connectionId        String
  externalEventId     String
  eventType           String
  severity            String    @default("INFO")
  occurredAt          DateTime?
  customerCode        String?
  serialNumber        String?
  payload             Json?
  state               String    @default("RECEIVED") // RECEIVED, MONITORING, IGNORED, APPROVED, ERROR
  bindingId           String?
  ticketId            String?
  serviceOrderId      String?
  errorCode           String?
  errorMessage        String?   @db.Text
  // Workflow gerencial. Todos os campos sao opcionais/default para manter a
  // migracao compativel com eventos historicos ja gravados.
  priorityLevel       String? // P1, P2, P3, P4
  priorityScore       Int?
  recommendation      Json?
  assignedToId        String?
  decisionDueAt       DateTime?
  monitoringUntil     DateTime?
  monitoringCondition String?   @db.Text
  nextStep            String?   @db.Text
  ignoredReason       String?   @db.Text
  decisionAt          DateTime?
  decisionById        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection PrintGuardConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([tenantId, state, createdAt])
  @@index([tenantId, severity, occurredAt])
  @@index([tenantId, customerCode, serialNumber])
  @@index([tenantId, assignedToId, decisionDueAt])
  @@index([tenantId, priorityLevel, state])
}

// Contrato do iLux normalizado e consultável (hoje só existe como ExternalSyncRecord
// raw, lido sob demanda). Populado pelo agente Firebird em firebirdSyncController.
model CrmContract {
  id                 String    @id @default(cuid())
  tenantId           String
  externalSource     String    @default("firebird")
  externalId         String // SEQCONTRATO / SEQIXLCONTRATOS
  customerExternalId String? // CDCLIENTE
  number             String?
  type               String?
  typeCode           String?
  modality           String? // "contador" | "franquia" | ...
  status             String?
  isActive           Boolean   @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  monthlyValue       Float?
  pageFranchise      Int?      @default(0) // qt_franquia
  franchiseValue     Float?    @default(0) // valor_franquia (R$ da franquia)
  excessPageValue    Float?    @default(0) // R$ por pagina excedente
  activeEquipment    Int?      @default(0) // IXLCONTRATOSIT (qtd ativa)
  raw                Json?
  externalUpdatedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalSource, externalId])
  @@index([tenantId, customerExternalId])
  @@index([tenantId, isActive])
}

// Historico append-only de leitura de contador. Uma linha por
// (equipamento, medidor, dia). Base para paginas/dia, rendimento e projecao.
model CrmMeterReading {
  id                  String    @id @default(cuid())
  tenantId            String
  equipmentExternalId String // CDEQUIPAMENTO
  serialNumber        String?
  meterCode           String? // CDMEDIDOR
  meterName           String? // rotulo do medidor
  reading             Int // valor do contador
  usageCounters       Json? // leituras por uso (mono/cor/scan etc.)
  previousReading     Int?
  readAt              DateTime // DTLEITURA (truncado ao dia, UTC)
  previousReadAt      DateTime?
  source              String    @default("firebird") // firebird | printguard | os
  createdAt           DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, equipmentExternalId, meterCode, readAt])
  @@index([tenantId, equipmentExternalId, readAt])
  @@index([tenantId, serialNumber, readAt])
}

// Demonstrativo de faturamento do iLux (IXLDEMOFAT), sincronizado pelo agente
// para o CRM poder re-renderizar o PDF sem depender da pasta monitorada (Fase 2
// de "faturamento sem a pasta"). Header aqui, linhas em CrmBillingStatementLine.
// Valores vêm fechados do ERP — o CRM nunca recalcula franquia/excedente.
// Um demonstrativo pode ter vários títulos (IRECEITAS) apontando para ele.
model CrmBillingStatement {
  id                      String    @id @default(cuid())
  tenantId                String
  externalSource          String    @default("firebird")
  externalId              String // SEQDEMONSTRATIVO
  period                  String? // PERIODO ("YYYY/MM")
  statementDate           DateTime? // DTDEMONSTRATIVO
  dueDate                 DateTime? // DTCOBRANCA
  customerExternalId      String? // CDCLIENTE
  companyExternalId       String? // CDEMPRESA
  contractGroupExternalId String? // SEQCONTRATOGRP
  receivableExternalId    String? // SEQRECEITA representativo (quando único)
  invoiceNumber           String? // NUMNF do título vinculado
  totalValue              Float?    @default(0) // VALDEMONSTRATIVO
  fixedValue              Float?    @default(0) // VALDEMONSTRATIVOF  == Σ franchiseCharged
  excessValue             Float?    @default(0) // VALDEMONSTRATIVOE  == Σ excessCharged
  discountValue           Float?    @default(0) // VALDESCONTO
  surchargeValue          Float?    @default(0) // VALACRESCIMO
  netValue                Float?    @default(0) // VL_DEMO_LIQ
  status                  String? // IXLDEMOFAT.STATUS
  notes                   String?   @db.Text // OBSERVACAO
  lineCount               Int       @default(0)
  raw                     Json? // snapshot do header + cliente/empresa resolvidos p/ render
  externalUpdatedAt       DateTime? // ATUALIZADO
  syncedAt                DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  CrmBillingStatementLine[]

  @@unique([tenantId, externalSource, externalId])
  @@index([tenantId, period])
  @@index([tenantId, receivableExternalId])
  @@index([tenantId, customerExternalId])
}

// Linha do "Quadro Resumo — Produção por Contrato/Cliente" (IXLCONTRATOSFAT).
// Imutável depois que o demonstrativo fecha; a sincronização apaga e recria
// todas as linhas do demonstrativo a cada push.
model CrmBillingStatementLine {
  id                      String    @id @default(cuid())
  tenantId                String
  statementId             String
  statementExternalId     String // SEQDEMONSTRATIVO (redundante, facilita debug)
  lineNo                  Int // ordem de sincronização (estável)
  contractExternalId      String? // SEQCONTRATO
  contractGroupExternalId String? // SEQCONTRATOGRP
  equipmentExternalId     String? // CDEQUIPAMENTO
  equipmentName           String? // IPRODUTO.NMPRODUTO
  equipmentModel          String? // IXLEQUIPAMENTO.MODELO
  equipmentSerial         String? // IXLEQUIPAMENTO.SERIE
  meterCode               String? // CDMEDIDOR
  meterCodeBilling        String? // CDMEDIDORFAT
  department              String? // DEPARTAMENTO
  installLocation         String? // LOCALINSTAL
  periodStart             DateTime? // DTPERIODOFATINI
  periodEnd               DateTime? // DTPERIODOFATFIN
  readingDate             DateTime? // DTLEITURA
  periodDays              Int? // NR_DIAS_PERIODO_FAT
  meterStart              Int? // MEDIDORINI
  meterEnd                Int? // MEDIDORFIN
  meterDiscount           Int? // MEDIDORDESC
  qtyProduction           Int? // QTPRODUCAO
  qtyFranchise            Int? // QTFRANQUIA
  qtyExcess               Int? // QTEXCEDENTE
  franchiseValue          Float?    @default(0) // VALFRANQUIA (preço de contrato)
  excessValue             Float?    @default(0) // VALEXCEDENTE (preço de contrato)
  franchiseCharged        Float?    @default(0) // VALFRANQUIACOB (efetivamente cobrado)
  excessCharged           Float?    @default(0) // VALEXCEDENTECOB (efetivamente cobrado)
  invoiceValue            Float?    @default(0) // VALFATURA
  discountValue           Float?    @default(0) // VALDESCONTO
  surchargeValue          Float?    @default(0) // VALACRESCIMO
  isFixed                 Boolean   @default(false) // TFFIXO = 'S'
  isExempt                Boolean   @default(false) // TFISENTO = 'S'
  isProrated              Boolean   @default(false) // TFRATEIO = 'S'
  isBonus                 Boolean   @default(false) // TFBONIFICACAO = 'S'
  raw                     Json?

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statement CrmBillingStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, lineNo])
  @@index([tenantId, statementExternalId])
}
model AttendanceTask {
  id             String    @id @default(cuid())
  tenantId       String
  title          String
  description    String?   @db.Text
  kind           String    @default("task")
  status         String    @default("open")
  dueAt          DateTime?
  completedAt    DateTime?
  assigneeId     String
  createdById    String
  teamId         String?
  contactId      String?
  ticketId       String?
  serviceOrderId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee       User     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy      User     @relation("TaskCreator", fields: [createdById], references: [id])
  team           Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ticket         Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId, assigneeId, status, dueAt])
  @@index([tenantId, teamId, status, dueAt])
}

model AttendancePolicy {
  id String @id @default(cuid())
  tenantId String @unique
  slaEnabled Boolean @default(false)
  assignmentEnabled Boolean @default(false)
  redistributeUnavailable Boolean @default(false)
  maxActiveTickets Int @default(10)
  unavailableMinutes Int @default(5)
  rules Json @default("[]")
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// "Fulano também está vendo/digitando" no Inbox. Uma linha por (userId,
// sessionId) - o front manda heartbeat a cada poucos segundos; linhas com
// lastSeenAt velho (>45s) são varridas no próprio heartbeat, sem cron.
model TicketPresence {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  ticketId     String
  sessionId    String
  lastSeenAt   DateTime  @default(now())
  typingUntil  DateTime?
  sendingUntil DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([tenantId, ticketId, lastSeenAt])
}

