FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:\ILUX\dados\ILUXBASE.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=preencha_a_senha_do_firebird
FIREBIRD_CHARSET=WIN1252

# Agent identity sent in each heartbeat. Update AGENT_VERSION whenever a new
# executable is released. Change AGENT_PROTOCOL_VERSION only when the
# agent/backend communication contract becomes incompatible.
AGENT_VERSION=1.0.1
AGENT_PROTOCOL_VERSION=1

CRM_BASE_URL=https://api-crm.lcddigital.com.br
CRM_TENANT_SLUG=lcddigital
CRM_SYNC_TOKEN=coloque_o_token_gerado_no_crm_aqui
SYNC_INTERVAL_SECONDS=300
BATCH_SIZE=250
SYNC_SERVICE_ORDERS_INCREMENTAL=true
STATE_FILE=state.json
LOG_DIR=logs
LOG_FILE=logs/client.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_LEVEL=INFO
# Automação de Cobranças / Envio de Faturas
BILLING_FOLDER_PATH=C:\ILUX\boletos_enviar
OWN_CNPJ=35.692.721/0001-94
# Pastas onde o usuário salva os PDFs oficiais em "Documentos em Lote".
# Use JSON para configurar mais de uma pasta. Todas as subpastas são monitoradas.
FINANCIAL_DOCUMENT_FOLDERS=["C:\\ILUX\\Documentos Financeiros"]
FINANCIAL_DOCUMENT_INDEX_FILE=financial-documents-index.json
FINANCIAL_DOCUMENT_SCAN_SECONDS=600
